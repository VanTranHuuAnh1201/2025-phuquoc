# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Luu y: monorepo -> dung pattern KHONG neo goc, de bat ca apps/*/ va packages/*/

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# turborepo
.turbo/

# misc
.DS_Store
*.pem
*.stackdump

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cho phep commit file mau env
!.env.local.example

# Ket qua crawl - noi dung va anh cua ben thu ba, KHONG duoc commit (luat R9).
# Ca file .seed.ts cung bi loai: chung hotlink hang nghin anh tu site goc
# (vd travlla-botble-com.seed.ts co ~1800 URL toi theme thuong mai CodeCanyon).
# Chay lai `pnpm crawl:*` de tao lai khi can.
/scripts/crawl/output/

# thung rac cua understand-anything
.ua/.trash-*/
resources/package