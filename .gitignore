# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Luu y: monorepo -> dung pattern KHONG neo goc, de bat ca apps/*/ va packages/*/

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
# `pnpm build:safe` ghi vào đây để không đụng `.next` mà dev server đang dùng
.next-build/
out/

# production
build/
dist/

# turborepo
.turbo/

# misc
.DS_Store
*.pem
*.stackdump

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
prompt-supabase.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ket qua crawl - noi dung va anh cua ben thu ba, KHONG duoc commit (luat R9).
# Ca file .seed.ts cung bi loai: chung hotlink hang nghin anh tu site goc
# (vd travlla-botble-com.seed.ts co ~1800 URL toi theme thuong mai CodeCanyon).
# Chay lai `pnpm crawl:*` de tao lai khi can.
/scripts/crawl/output/

# thung rac cua understand-anything
.ua/.trash-*/
resources/package
# Hash mật khẩu nhân viên demo (200-01) — sinh lại bằng: pnpm seed:hash
resources/scripts/seed/staff-hashes.json

# Ảnh chụp và report của Playwright — sinh lại bằng `pnpm test:e2e`.
# Commit vào thì mỗi lần chạy lại là một diff nhị phân vô nghĩa, che mất
# thay đổi code thật khi review.
e2e-out/
playwright-report/
test-results/
.gstack/

# Ảnh do admin tải lên qua CMS (`POST /api/admin/upload`) — nội dung vận hành,
# không phải mã nguồn. Chỉ loại file `.webp` vì route upload luôn xuất WebP;
# 22 ảnh seed sẵn có (`.jpg`/`.png`) vẫn được commit như trước.
#
# ⚠️ NHẮC LẠI giới hạn đã ghi trong route: filesystem của Vercel là ephemeral,
# ảnh tải lên MẤT sau mỗi lần deploy. Chỉ dùng cho dev/demo — lên production
# phải đổi `persist()` sang Supabase Storage hoặc Vercel Blob.
apps/*/public/uploads/*.webp
