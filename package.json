{
  "name": "booking-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm free-ports && turbo dev",
    "dev:portfolio": "pnpm free-ports 3002 && turbo dev --filter=@repo/portfolio",
    "dev:thenamduhill": "pnpm free-ports 3000 && turbo dev --filter=@repo/2026-thenamduhill",
    "dev:thenamduhillresort": "pnpm free-ports 3003 && turbo dev --filter=@repo/2026-thenamduhillresort",
    "dev:phogroup": "pnpm free-ports 3001 && turbo dev --filter=@repo/2025-phogroup",
    "build": "turbo build",
    "build:safe": "node resources/scripts/build-safe.mjs",
    "free-ports": "node resources/scripts/free-ports.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo lint typecheck",
    "clean": "turbo clean && rimraf node_modules",
    "crawl:pages": "node resources/scripts/crawl/crawl-pages.mjs",
    "crawl:build": "node resources/scripts/crawl/build-seed.mjs && node resources/scripts/crawl/emit-ts.mjs && node resources/scripts/crawl/emit-property-data.mjs && node resources/scripts/crawl/emit-resort-data.mjs",
    "crawl:travlla": "node resources/scripts/crawl/crawl-travlla.mjs",
    "crawl:travlla:build": "node resources/scripts/crawl/build-travlla-seed.mjs && node resources/scripts/crawl/emit-travlla-ts.mjs",
    "crawl:rooms": "node resources/scripts/crawl/crawl-room-details.mjs",
    "crawl:full": "node resources/scripts/crawl/crawl-full-site.mjs",
    "crawl:property": "node resources/scripts/crawl/emit-property-data.mjs"
  },
  "devDependencies": {
    "@mendable/firecrawl-js": "^4.32.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "marked": "^18.0.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "turbo": "^2.3.3",
    "typescript": "^5"
  }
}
